{
  "name": "bankglass",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted, read-only REST API and Model Context Protocol server for Akahu-connected accounts.",
  "keywords": [
    "akahu",
    "banking",
    "cloudflare-workers",
    "durable-objects",
    "mcp",
    "model-context-protocol",
    "read-only",
    "rest-api"
  ],
  "homepage": "https://github.com/mynameistito/bankglass#readme",
  "bugs": {
    "url": "https://github.com/mynameistito/bankglass/issues"
  },
  "license": "MIT",
  "author": {
    "name": "mynameistito",
    "url": "https://github.com/mynameistito"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mynameistito/bankglass.git"
  },
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "build:worker": "wrangler deploy src/index.ts --dry-run --outdir dist/alchemy-worker --name bankglass --compatibility-date=2026-07-11 --compatibility-flags=nodejs_compat",
    "deploy": "varlock run -- alchemy deploy --stage \"$STAGE\"",
    "dev": "varlock run -- alchemy dev",
    "audit": "bun audit --ignore=GHSA-vfj7-8cjw-p6xm",
    "test": "vitest run",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@modelcontextprotocol/server": "2.3.1",
    "@varlock/1password-plugin": "2.0.5",
    "agents": "^0.29.0",
    "alchemy": "2.0.0-beta.84",
    "effect": "^4.0.6",
    "jose": "^6.2.13",
    "varlock": "1.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@effect/platform-bun": "4.0.6",
    "@effect/platform-node": "4.0.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "knip": "6.42.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "8.0.1",
    "vitest": "^5.0.5",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "hono": "4.13.13",
    "lodash": "4.18.0",
    "undici@<7.30.1": "7.30.1",
    "valibot": "1.4.2",
    "zod@<4.6.6": "4.6.7"
  },
  "packageManager": "bun@1.4.3",
  "varlock": {
    "loadPath": "./.env.tpl"
  }
}
