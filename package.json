{
  "name": "bankglass",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted, read-only REST API and Model Context Protocol server for Akahu-connected accounts.",
  "keywords": [
    "akahu",
    "banking",
    "cloudflare-workers",
    "durable-objects",
    "mcp",
    "model-context-protocol",
    "read-only",
    "rest-api"
  ],
  "homepage": "https://github.com/mynameistito/bankglass#readme",
  "bugs": {
    "url": "https://github.com/mynameistito/bankglass/issues"
  },
  "license": "MIT",
  "author": {
    "name": "mynameistito",
    "url": "https://github.com/mynameistito"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mynameistito/bankglass.git"
  },
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "deploy": "alchemy deploy",
    "dev": "STAGE=dev alchemy dev --env-file .dev.vars",
    "test": "vitest run",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "^0.28.1",
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.4",
    "jose": "^6.2.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@effect/platform-bun": "4.0.4",
    "@effect/platform-node": "4.0.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "knip": "6.41.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "7.12.4",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.4.0"
}
